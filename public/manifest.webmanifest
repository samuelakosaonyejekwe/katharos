{
  "id": "./",
  "name": "Katharos Title Desk",
  "short_name": "Katharos",
  "description": "Clean-title due diligence for Cypriot property: search-certificate checks, multilingual buyer reports, deadline watch and live market data. Works offline.",
  "lang": "en",
  "dir": "auto",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f3ec",
  "theme_color": "#0b4f63",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "New matter", "url": "./#/matters/new", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Deadlines", "url": "./#/deadlines", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Live market", "url": "./#/live", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./#/share",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "prefer_related_applications": false
}
